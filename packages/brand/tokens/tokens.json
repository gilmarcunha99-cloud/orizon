{
  "$description": "Design tokens ORIZON SPORTS, derivados do BrandBook (Canva, out/2025). Cores 'brand' são oficiais; escalas, status e semânticos são derivados para o app.",
  "color": {
    "brand": {
      "deepHorizonBlue": "#003E49",
      "energyPulseOrange": "#E48519",
      "steelGray": "#6C7A7A",
      "cloudMist": "#E4E7E7",
      "cloudMistWarm": "#EDE7DB"
    },
    "blue":   { "50": "#EBF0F0", "100": "#CCD8DB", "200": "#99B2B6", "300": "#668B92", "400": "#33656D", "500": "#003E49", "600": "#00323A", "700": "#00282F", "800": "#001F24", "900": "#00161A" },
    "orange": { "50": "#FDF5ED", "100": "#FAE7D1", "200": "#F4CEA3", "300": "#EFB675", "400": "#E99D47", "500": "#E48519", "600": "#B66A14", "700": "#945610", "800": "#72420C", "900": "#502F09" },
    "gray":   { "50": "#F3F4F4", "100": "#E2E4E4", "200": "#C4CACA", "300": "#A7AFAF", "400": "#899595", "500": "#6C7A7A", "600": "#566262", "700": "#464F4F", "800": "#363D3D", "900": "#262B2B" },
    "status": { "success": "#1B7A4F", "warning": "#946200", "danger": "#C8372D", "info": "#1F6FB2" },
    "semantic": {
      "light": {
        "background": "#F3F4F4", "surface": "#FFFFFF", "surfaceAlt": "#EDE7DB",
        "textPrimary": "#003E49", "textSecondary": "#566262", "textOnPrimary": "#FFFFFF",
        "primary": "#003E49", "primaryPressed": "#00282F",
        "accent": "#E48519", "accentText": "#945610", "onAccent": "#003E49",
        "border": "#C4CACA", "focus": "#E48519"
      },
      "dark": {
        "background": "#00161A", "surface": "#001F24", "surfaceAlt": "#00323A",
        "textPrimary": "#FFFFFF", "textSecondary": "#C4CACA", "textOnPrimary": "#003E49",
        "primary": "#E48519", "primaryPressed": "#B66A14",
        "accent": "#E48519", "accentText": "#EFB675", "onAccent": "#003E49",
        "border": "#33656D", "focus": "#EFB675"
      }
    }
  },
  "font": {
    "family": { "heading": "Poppins", "section": "Oswald", "body": "Poppins" },
    "weight": { "light": 300, "regular": 400, "bold": 700, "black": 900 },
    "scale": {
      "display":  { "family": "Poppins", "size": 32, "line": 40, "weight": 800, "case": "uppercase" },
      "h1":       { "family": "Poppins", "size": 24, "line": 32, "weight": 700 },
      "h2":       { "family": "Poppins", "size": 20, "line": 28, "weight": 700 },
      "section":  { "family": "Oswald",  "size": 16, "line": 20, "weight": 700, "case": "uppercase", "letterSpacing": 0.5 },
      "body":     { "family": "Poppins", "size": 16, "line": 24, "weight": 400 },
      "bodySm":   { "family": "Poppins", "size": 14, "line": 20, "weight": 400 },
      "caption":  { "family": "Poppins", "size": 12, "line": 16, "weight": 400 },
      "numeric":  { "family": "Oswald",  "size": 28, "line": 32, "weight": 700, "note": "tempos, pace, placar, pódio" }
    }
  },
  "radius": { "sm": 8, "md": 12, "lg": 20, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "logo": {
    "minWidth": { "horizontalPx": 120, "symbolPx": 24 },
    "clearSpace": "altura do círculo (sol) em volta da marca"
  }
}
